{
  "name": "learned-markets",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "tsc -p packages/attestations && tsc -p apps/attestation-service",
    "test": "npm run test -w @learned-markets/attestations && npm run test -w @learned-markets/attestation-service",
    "test:programs": "anchor build && cargo test -p learned-markets && cd tests/program-tests && cargo test",
    "rollout": "node scripts/rollout.ts"
  },
  "devDependencies": {
    "@solana-program/system": "0.15.0",
    "@solana/kit": "8.3.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
